# Copia este archivo como .streamlit/secrets.toml (en local) o pega su contenido en
# Streamlit Community Cloud → App → Settings → Secrets. No subas nunca el secrets.toml real.

# Envío del informe por email (opcional). Para Gmail usa una "contraseña de aplicación".
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SENDER_EMAIL = "tu_correo@gmail.com"
SENDER_PASSWORD = "contraseña_de_aplicación"

# Puntos de carga de OpenChargeMap (opcional, clave gratuita en https://openchargemap.org/site/developerinfo)
# OCM_API_KEY = "tu_clave"
